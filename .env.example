# Configurações do StreamFlow para Docker Compose

# Porta externa mapeada no host (Padrão: 8084)
PORT=8084

# Perfil do Spring Boot
SPRING_PROFILES_ACTIVE=prd

# Senha de acesso para os usuários entrarem na plataforma
APP_ACCESS_PASSWORD=amigos123

# Chave secreta de administração (para reset de cota e operações restritas)
APP_ADMIN_KEY=admin_super_secret_9981

# Origens permitidas para CORS (use * para permitir qualquer ou especifique o domínio: https://seusite.com)
CORS_ALLOWED_ORIGINS=*

# Credenciais da Cloudflare Calls (WebRTC SFU)
# Obtenha no painel: https://dash.cloudflare.com/ -> Calls (Realtime) -> Create App
CLOUDFLARE_CALLS_APP_ID=seu_app_id_aqui
CLOUDFLARE_CALLS_APP_SECRET=seu_app_secret_aqui
CLOUDFLARE_CALLS_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_CALLS_ANALYTICS_TOKEN=seu_analytics_token_aqui

# Nível de logging (INFO, WARN, ERROR, DEBUG)
LOG_LEVEL=INFO
