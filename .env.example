# Configurações do StreamFlow para Docker Compose

# Porta externa mapeada no host (Padrão: 8084)
PORT=8084

# Perfil do Spring Boot
SPRING_PROFILES_ACTIVE=prd

# Chave secreta de administração (para reset de cota e operações restritas)
APP_ADMIN_KEY=admin_super_secret_9981

# Segredo que assina as sessões de login (gere um valor longo e aleatório; trocar desloga todo mundo)
# Ex: openssl rand -hex 32
APP_SESSION_SECRET=
# Duração da sessão em dias
APP_SESSION_TTL_DAYS=60

# Origens permitidas para CORS (use * para permitir qualquer ou especifique o domínio: https://seusite.com)
CORS_ALLOWED_ORIGINS=*

# Credenciais da Cloudflare Calls (WebRTC SFU)
# Obtenha no painel: https://dash.cloudflare.com/ -> Calls (Realtime) -> Create App
CLOUDFLARE_CALLS_APP_ID=seu_app_id_aqui
CLOUDFLARE_CALLS_APP_SECRET=seu_app_secret_aqui
CLOUDFLARE_CALLS_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_CALLS_ANALYTICS_TOKEN=seu_analytics_token_aqui

# Integração com o Discord (Developer Portal: https://discord.com/developers/applications)
# Login com Discord é a única forma de entrar (só membros do servidor): CLIENT_ID, CLIENT_SECRET, BOT_TOKEN, GUILD_ID e REDIRECT_URI
# Aviso de live no canal: precisa de BOT_TOKEN e CHANNEL_ID
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Deve ser idêntico ao cadastrado em OAuth2 > Redirects (ex: https://seusite.com/api/auth/discord/callback)
DISCORD_REDIRECT_URI=
# Opcional: ID de um cargo exigido para entrar
DISCORD_REQUIRED_ROLE_ID=
# Link do site no aviso (ex: https://seusite.com)
DISCORD_PUBLIC_URL=
# Intervalo mínimo entre avisos do mesmo usuário
DISCORD_NOTIFY_COOLDOWN_SECONDS=600
# true para o aviso marcar quem está em canais de voz (exige DISCORD_GUILD_ID)
DISCORD_NOTIFY_MENTION_VOICE=true

# Nível de logging (INFO, WARN, ERROR, DEBUG)
LOG_LEVEL=INFO
